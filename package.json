{
    "name": "@viteplus/versions",
    "main": "dist/index.js",
    "type": "module",
    "types": "./dist/index.d.ts",
    "module": "./dist/index.js",
    "author": "Garefild",
    "version": "1.0.0-local",
    "license": "Mozilla Public License Version 2.0",
    "description": "A versioning plugin for VitePress",
    "homepage": "https://viteplus.github.io/versions/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/viteplus/versions.git"
    },
    "bugs": {
        "url": "https://github.com/viteplus/versions/issues"
    },
    "keywords": [
        "vite",
        "plugin",
        "versions",
        "vitepress",
        "versioning"
    ],
    "engines": {
        "node": ">=20"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "components"
    ],
    "scripts": {
        "dev":              "xBuild -w",
        "build":            "xBuild",
        "build:clean":      "rm -rf ./dist && xBuild",

        "test":             "xjet",
        "test:coverage":    "xjet --coverage",

        "lint":             "pnpm lint:md && pnpm lint:eslint && pnpm lint:typescript",
        "lint:md":          "markdownlint \"**/*.md\" --ignore node_modules",
        "lint:eslint":      "eslint . -c ./eslint.config.mjs",
        "lint:typescript":  "xBuild --tc",

        "docs:dev":         "vitepress dev docs",
        "docs:build":       "vitepress build docs",
        "docs:preview":     "vitepress preview docs"
    },
    "dependencies": {
        "vitepress": "^2.0.0-alpha.18",
        "@remotex-labs/xansi": "^1.3.7"
    },
    "devDependencies": {
        "eslint": "^10.7.0",
        "markdownlint-cli": "^0.49.1",
        "typescript-eslint": "^8.65.0",
        "eslint-plugin-tsdoc": "^0.5.2",
        "eslint-plugin-perfectionist": "^5.10.0",
        "@types/node": "^26.1.1",
        "@viteplus/versions": "^2.0.6",
        "@remotex-labs/xjet": "^1.5.6",
        "@remotex-labs/xbuild": "^2.5.1"
    },
    "peerDependencies": {
        "vitepress": "^1.6.4 || ^2.0.0"
    },
    "peerDependenciesMeta": {
        "vitepress": {
            "optional": true
        }
    }
}
