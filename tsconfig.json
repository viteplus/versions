{
    "compilerOptions": {
        "strict": true,
        "target": "ESNext",
        "module": "ESNext",
        "outDir": "dist",
        "rootDir": ".",
        "composite": false,
        "declaration": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "experimentalDecorators": true,
        "moduleDetection": "force",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "emitDeclarationOnly": true,
        "lib": [
            "DOM",
            "ESNext"
        ],
        "types": [
            "node"
        ],
        "paths": {
            "@models/*": [
                "./src/models/*"
            ],
            "@constants/*": [
                "./src/constants/*"
            ],
            "@components/*": [
                "./src/components/*"
            ],
            "@interfaces/*": [
                "./src/interfaces/*"
            ],
            "@symlinks/*": [
                "./src/modules/symlinks/*"
            ]
        }
    },
    "include": [
        "src/index.ts"
    ],
    "exclude": [
        "dist",
        "**/*.spec.ts",
        "node_modules"
    ],
    "references": [
        { "path": "./tsconfig.spec.json" }
    ]
}
